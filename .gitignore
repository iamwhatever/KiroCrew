# 打包产物：只留给下载安装用，不进 git
dist/
Kiro_BYO_*-release/
Kiro_BYO_*-source/
*.whl
*.zip
SHA256SUMS.txt

# Python 编译缓存
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# 真实本地配置（可能含模型 API 密钥），只放样例
config/*.json
!config/*.example.json

# 架构预算是纯数字、不含密钥；测试与守卫脚本都依赖它，必须入库
!config/architecture_budget.json

# 编辑器与系统杂项
.vscode/
.idea/
Thumbs.db
.DS_Store
